# Groq LLM Configuration
# Get free API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Redis Configuration
# If running with Docker Compose (recommended), use: redis
# If running Redis locally, use: localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Conversation Memory TTL (hours)
CONVERSATION_TTL_HOURS=24

# ==================== Observability & Monitoring ====================

# LangSmith Configuration (Optional)
# Get API key from: https://smith.langchain.com
# This enables traces and monitoring of LLM chains in your Insurance AI app
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=insurance-ai

# Azure Application Insights Configuration (Optional)
# Creates an Application Insights resource in Azure Portal
# Use connection string format: InstrumentationKey=<guid>;IngestionEndpoint=<url>;LiveEndpoint=<url>
# If not set, the app will log warnings but continue to work
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ==================== Application Settings ====================
DEBUG=false
LOG_LEVEL=INFO
